{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "ng serve (svil)",
      "command": "npx ng serve --configuration svil --port 4202",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "ng serve (dev)",
      "command": "npx ng serve --port 4202",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Debug Angular su Chrome",
      "url": "http://localhost:4202",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Serve Angular App",
      "sourceMaps": true,
      "runtimeArgs": [
        "--disable-features=VizDisplayCompositor"
      ]
    },
    {
      "type": "chrome",
      "request": "attach",
      "name": "Attach to Chrome",
      "port": 9222,
      "webRoot": "${workspaceFolder}",
      "url": "http://localhost:4202"
    }
  ]
}
